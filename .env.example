# Copy to .env and fill in. Nothing here is secret — the MLB The Show API needs
# no key, no token and no login. These are just *which* accounts to crawl.

# Your Show username, exactly as it appears in-game (case doesn't matter for
# lookups, but it's stored as written).
MY_USERNAME=LinguiniEater

# The rival. Head-to-head games are the ones where the opponent is this user.
FRIEND_USERNAME=TallThibaut48

# psn | xbl | mlbts | nsw
#
# NOTE: game_history.json ignores this entirely (any value returns your full
# history), but game_log.json strictly validates the (id, username, platform)
# triple and 400s with "Username and platform do not match the game record."
# if it's wrong. So it must be correct or box scores won't load.
PLATFORM=psn

# Which edition of the game to crawl. Drives the base URL:
#   26 -> https://mlb26.theshow.com/apis
#
# Each year is a completely separate silo — MLB 25 games live only on
# mlb25.theshow.com and are NOT visible from mlb26. To backfill an older
# season, set this to 25 and re-run `ingest history`; rows are tagged with
# season_year so both can coexist in the same database.
SEASON_YEAR=26

# Seconds to sleep between API requests. The API publishes no rate limits and
# returns no rate-limit headers, but SDS does throttle aggressive clients, so
# be polite. ~0.35s (roughly 3 req/s) has tested clean over hundreds of calls.
REQUEST_DELAY=0.35


# ---------------------------------------------------------------- league rules
# The Show keeps no season structure, so the site imposes one. Full design and
# the data behind it: SEASONS-PLAN.md.
#
# Do not confuse these with SEASON_YEAR above, which is the edition of the game.

# When Season 1 opens. The first head-to-head game played on or after this
# moment is Season 1, Series 1, Game 1. Everything earlier belongs to no season
# and is not backfilled — the two players start level at zero championships.
#
# Accepts a bare date (2026-08-06) or a local timestamp (2026-08-05T17:23:00).
# Use a timestamp to start mid-day. It must carry NO UTC offset: the value is
# compared as a string against games.played_at, which is naive local time, so a
# trailing "-05:00" would sort against the seconds field and quietly swallow the
# rest of the day's games.
#
# Moving this forward re-derives every season from scratch, so change it only
# before a season has begun.
LEAGUE_START=2026-08-05T17:23:00

# Wins needed to take a regular-season series. 3 = best-of-five.
SERIES_WINS=3

# Series in a regular season. Once this many close, the next series is
# automatically the World Series — there is nothing to declare.
SEASON_LENGTH=8

# Wins needed to take the World Series. 4 = best-of-seven.
WORLD_SERIES_WINS=4
